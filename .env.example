# Copy to .env and fill in real values. Never commit .env.
#
# Generate a value:
#   openssl rand -base64 48 | tr -d '/+=\n' | head -c 32

# Postgres password. Used by both the postgres service and the
# DATABASE_CONNECTION_URI passed to evolution-api — they must stay in sync,
# which is why compose interpolates this one variable in both places.
POSTGRES_PASSWORD=

# Evolution API auth key. Must be set: the upstream image falls back to a
# hardcoded public default when this is empty, leaving the API unauthenticated.
AUTHENTICATION_API_KEY=
